# Build environment for the locally patched Calamares packages (aaropa_calamares,
# aaropa_calamares_modules_bass). Same distro and dependencies as their ci/setup.sh.
FROM docker.io/library/debian:unstable-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates debhelper devscripts fakeroot git wget \
      cryptsetup pkg-kde-tools pkexec os-prober rsync gettext pkgconf python3 \
      cmake extra-cmake-modules libcrypt-dev libkpmcore-dev libparted-dev \
      libpwquality-dev libboost-python-dev libyaml-cpp-dev \
      libkf6config-dev libkf6config-dev-bin libkf6configwidgets-dev libkf6coreaddons-dev \
      libkf6crash-dev libkf6i18n-dev libkf6iconthemes-dev libkf6kio-dev \
      libkf6notifyconfig-dev libkf6package-dev libkf6parts-dev libkf6service-dev \
      libkf6solid-dev libpolkit-qt6-1-dev \
      qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-declarative-dev-tools \
      qt6-declarative-private-dev qt6-svg-dev qt6-tools-dev qt6-tools-dev-tools \
      qml6-module-qtquick-layouts qml6-module-qtquick-window qml6-module-qtquick \
    && rm -rf /var/lib/apt/lists/*
